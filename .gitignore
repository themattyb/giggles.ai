# Environment files with credentials
.env
*.env
.env.local
.env.*.local

# AWS credentials
credentials.txt
aws-credentials.txt
.aws-credentials

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Go build artifacts (if building at root)
*.exe
*.exe~
*.dll
*.so
*.dylib

# Logs
*.log

# Node (GUI dev tooling)
node_modules/
npm-debug.log*

# Crawler-generated GUI manifest (local artifact). The committed gui/memes.json
# is portable sample data; the real manifest is generated per-machine by
# scripts/crawl.sh / `crawler -gen-manifest` and must not be committed.
gui/memes.local.json


# oh-my-claudecode runtime state (per-session, per-machine). .omc/skills/ is
# the intentional committable exception.
/.omc/*
!/.omc/skills/
/*/**/.omc/
